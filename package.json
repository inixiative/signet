{
  "name": "@inixiative/signet",
  "version": "0.3.0",
  "description": "Present Kingdom Signets: the wire contracts, DPoP proofs, device pairing and a renewing client shared by Kingdom, Archive, Foundry and Oracle.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./proof": "./src/proof.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run check",
    "lint": "biome check .",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi"
  },
  "keywords": [
    "kingdom",
    "signet",
    "dpop",
    "access",
    "grant"
  ],
  "license": "MIT",
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@inixiative/config": "^0.5.60",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.9",
    "typescript": "6.0.3",
    "zod": "^4.3.6"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/signet.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  }
}
