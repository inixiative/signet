{
  "name": "@inixiative/signet",
  "version": "0.29.0",
  "description": "Present Kingdom Signets: the wire contracts, DPoP proofs, device pairing and a renewing client shared by Kingdom, Archive, Foundry and Oracle.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./proof": "./src/proof.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:all": "bun run typecheck && bun run lint && bun run test",
    "check": "inixiative-config bounded -- bun run check:all",
    "prepublishOnly": "bun run check",
    "lint": "biome check .",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi"
  },
  "keywords": [
    "kingdom",
    "signet",
    "dpop",
    "access",
    "grant"
  ],
  "license": "MIT",
  "dependencies": {
    "@inixiative/field-map": "^0.1.2",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@biomejs/biome": "2.5.2",
    "@inixiative/config": "^0.5.254",
    "@inixiative/json-rules": "^4.7.0",
    "@types/bun": "1.4.4",
    "lefthook": "2.1.9",
    "typescript": "6.0.3",
    "zod": "^4.3.6"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/signet.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "zod": "^4.3.6",
    "@inixiative/json-rules": "^4.2.0"
  }
}
